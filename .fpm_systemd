-s dir
--name pathology-core
--category net
--license GPL-3.0-or-later
--description "The universal proxy platform."
--url "https://hiddify.com/"
--maintainer "hiddify <core@hiddify.com>"
--deb-field "Bug: https://github.com/ne-tort/pathology-core/issues"
--no-deb-generate-changes
--config-files /etc/pathology-core/config.json
--after-install release/config/pathology-core.postinst

release/config/config.json=/etc/pathology-core/config.json

release/config/pathology-core.service=/usr/lib/systemd/system/pathology-core.service
release/config/pathology-core@.service=/usr/lib/systemd/system/pathology-core@.service
release/config/pathology-core.sysusers=/usr/lib/sysusers.d/pathology-core.conf
release/config/pathology-core.rules=usr/share/polkit-1/rules.d/pathology-core.rules
release/config/pathology-core-split-dns.xml=/usr/share/dbus-1/system.d/pathology-core-split-dns.conf

LICENSE.md=/usr/share/licenses/pathology-core/LICENSE.md