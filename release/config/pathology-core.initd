#!/sbin/openrc-run

name=$RC_SVCNAME
description="pathology-core service"
supervisor="supervise-daemon"
command="/usr/bin/pathology-core"
command_args="-D /var/lib/pathology-core -C /etc/pathology-core run"
extra_started_commands="reload"

depend() {
	after net dns
}

reload() {
	ebegin "Reloading $RC_SVCNAME"
        $supervisor "$RC_SVCNAME" --signal HUP
	eend $?
}